<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppRestaurant.ViewModels"
             x:Class="AppRestaurant.Views.ProductManagementPage"
             Title="Gestionare Produse">

    <ContentPage.BindingContext>
        <vm:ProductManagementViewModel />
    </ContentPage.BindingContext>

    <ContentPage.BackgroundImageSource>
        <FileImageSource File="restaurant_background.jpg" />
    </ContentPage.BackgroundImageSource>

    <ScrollView>
        <StackLayout Padding="20" Spacing="15" BackgroundColor="#FAF3E0">
            
            <Label Text="Gestionare Produse" FontSize="36" FontAttributes="Bold" TextColor="#8B0000" HorizontalOptions="Center"/>

            
            <Button Text="Adaugă Produs Nou"
                    BackgroundColor="#8B0000"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Padding="10,5"
                    Command="{Binding AddProductCommand}"/>

            
            <CollectionView x:Name="ProductsList" ItemsSource="{Binding Products}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#D3B8AE" CornerRadius="15" Padding="15" Margin="5" BackgroundColor="White" HasShadow="True">
                            <StackLayout Orientation="Vertical" Spacing="8">
                                <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" TextColor="#8B0000"/>
                                <Label Text="{Binding Description}" FontSize="14" TextColor="#5A3E36"/>
                                <Label Text="{Binding Price, StringFormat='Preț: {0:C}'}" FontSize="16" TextColor="#000000"/>

                                
                                <StackLayout Orientation="Horizontal" Spacing="10">
                                    <Button Text="Editeaza"
                                            BackgroundColor="#FF8C00"
                                            TextColor="White"
                                            CornerRadius="10"
                                            Command="{Binding BindingContext.EditProductCommand, Source={x:Reference ProductsList}}"
                                            CommandParameter="{Binding .}"/>

                                    <Button Text="Sterge"
                                            BackgroundColor="#8B0000"
                                            TextColor="White"
                                            CornerRadius="10"
                                            Command="{Binding BindingContext.DeleteProductCommand, Source={x:Reference ProductsList}}"
                                            CommandParameter="{Binding .}"/>
                                </StackLayout>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>
