<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppRestaurant.ViewModels"
             x:Class="AppRestaurant.Views.NotificatiosPage"
             Title="Notificari">

    <ContentPage.BindingContext>
        <vm:NotificationsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <StackLayout Padding="20" Spacing="15" BackgroundColor="#FAF3E0">
            <Label Text="Notificarile Tale"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="#8B0000"
                   HorizontalOptions="Center"/>

            <CollectionView x:Name="NotificationsList" ItemsSource="{Binding Notifications}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#D3B8AE"
                               CornerRadius="15"
                               Padding="15"
                               Margin="5"
                               BackgroundColor="White"
                               HasShadow="True">
                            <StackLayout Orientation="Vertical" Spacing="8">
                                <Label Text="{Binding Title}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#8B0000"/>

                                <Label Text="{Binding Message}"
                                       FontSize="14"
                                       TextColor="#5A3E36"
                                       LineBreakMode="WordWrap"/>

                                <Label Text="{Binding CreatedAt, StringFormat='Data: {0:dd/MM/yyyy HH:mm}'}"
                                       FontSize="14"
                                       TextColor="#000000"/>

                                
                                <Button Text="Elimină"
                                        BackgroundColor="#FF8C00"
                                        TextColor="White"
                                        CornerRadius="10"
                                        Command="{Binding BindingContext.DeleteNotificationCommand, Source={x:Reference NotificationsList}}"
                                        CommandParameter="{Binding .}"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>